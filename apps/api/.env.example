# --- Database ---
# Local default (no setup required):
DATABASE_URL=sqlite+aiosqlite:///./vira.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vira

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI providers (all default to mock mode when unset) ---
AI_PROVIDER_MODE=mock          # "mock" or "live"
LLM_API_KEY=
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=

# --- File storage ---
STORAGE_MODE=local             # "local" or "s3"
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
